{
  "name": "BrandX Portfolio",
  "dataColors": ["#0047AB", "#A9B4C6", "#C26A00", "#7FA6DB", "#F2B872", "#0B2E6B", "#5B8BD0", "#D9DEE7"],
  "background": "#FFFFFF",
  "foreground": "#1F2A44",
  "tableAccent": "#0047AB",
  "good": "#0047AB",
  "neutral": "#A9B4C6",
  "bad": "#C26A00",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2A44" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A44" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 11, "color": "#3A4458" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#0047AB" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#F4F6FA" } }, "transparency": 0 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#3A4458" } }, "textSize": 11 }],
        "items":  [{ "fontColor": { "solid": { "color": "#1F2A44" } }, "textSize": 10 }]
      }
    }
  }
}
